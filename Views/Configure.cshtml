@model Nop.Plugin.ExternalAuth.Google.Models.ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

@*autocomplete off: browsers / password managers would otherwise fill the admin login into the client ID and secret*@
<form asp-controller="GoogleAuthentication" asp-action="Configure" method="post" autocomplete="off">
    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    @Html.Raw(T("Plugins.ExternalAuth.Google.Instructions").Text)
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper"><label class="col-form-label">@T("Plugins.ExternalAuth.Google.RedirectUri")</label></div>
                        </div>
                        <div class="col-md-9">
                            <div class="input-group">
                                <input type="text" class="form-control" readonly value="@Model.RedirectUri" id="google-redirect-uri" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-default" onclick="navigator.clipboard.writeText(document.getElementById('google-redirect-uri').value)"><i class="far fa-copy"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="ClientId" /></div>
                        <div class="col-md-9"><nop-editor asp-for="ClientId" html-attributes="@(new { autocomplete = "off", data_lpignore = "true", data_1p_ignore = "true" })" /><span asp-validation-for="ClientId"></span></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="ClientSecret" /></div>
                        <div class="col-md-9"><nop-editor asp-for="ClientSecret" html-attributes="@(new { type = "password", autocomplete = "new-password", data_lpignore = "true", data_1p_ignore = "true" })" /><span asp-validation-for="ClientSecret"></span></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
